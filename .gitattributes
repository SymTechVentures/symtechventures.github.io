# Keep source and structured text deterministic across Windows and Linux.
* text=auto
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
*.png binary
*.jpg binary
*.webp binary

.gitattributes text eol=lf

.gitignore text eol=lf
